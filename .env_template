# QuestMaster — local/server environment template
# Copy this file to `.env` for local development or server deployment.
# NEVER commit `.env` or any real secret values.

# -----------------------------
# Application
# -----------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Frontend origins allowed to call the FastAPI backend.
# Local example: http://localhost:5173
# Production example: https://questmaster.tech
CORS_ORIGINS=http://localhost:5173,https://questmaster.tech

# -----------------------------
# LLM provider
# -----------------------------
# Runtime code should stay provider-agnostic.
# Preferred hackathon provider: Meta Model API.
LLM_PROVIDER=meta
LLM_FAST_MODEL=muse-spark-1.3
LLM_STRONG_MODEL=muse-spark-1.3

# Meta Model API
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1

# Optional future providers — leave blank unless actually used.
GEMINI_API_KEY=
OPENAI_API_KEY=

# -----------------------------
# Capital One Nessie
# -----------------------------
NESSIE_API_KEY=
NESSIE_BASE_URL=https://api.nessieisreal.com

# -----------------------------
# Tiger Data / PostgreSQL
# -----------------------------
# Tiger Cloud connection string. Leave blank to run with in-memory run state only.
# Example: postgresql+psycopg://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL=

# -----------------------------
# Cost / safety limits
# -----------------------------
MAX_LLM_CALLS_PER_RUN=6
MAX_ESTIMATED_RUN_COST_USD=0.25

# -----------------------------
# Demo configuration
# -----------------------------
DEFAULT_WORKSPACE_ID=toyota-demo
DEFAULT_DEMO_USER_ID=demo-user

# Use local fixture data when Nessie is unavailable.
NESSIE_FALLBACK_ENABLED=true

# Use deterministic/fallback planning when LLM is unavailable.
LLM_FALLBACK_ENABLED=true

# -----------------------------
# Logging
# -----------------------------
LOG_LEVEL=INFO

# IMPORTANT:
# Do NOT put Vultr account credentials, GitHub credentials, .tech registrar
# credentials, Cursor credentials, or browser-subscription credentials here.
# Vultr VM access is handled via SSH; .tech is configured through DNS.
